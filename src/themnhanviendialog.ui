  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. NỀN DIALOG &amp; TIÊU ĐỀ
========================================= */
QDialog {
    background-color: #f0f4f8; /* Xám pha xanh cực nhạt, tạo cảm giác không gian sạch sẽ */
}

QLabel#lblTieuDe {
    color: #1a252f; /* Navy cực đậm cho độ tương phản cao nhất */
    font-size: 22px;
    font-weight: 900;
    font-family: &quot;Segoe UI&quot;;
    padding-bottom: 15px;
    padding-top: 10px;
}

/* Tiêu đề các dòng chữ (Mã nhân viên, Tên...) */
QLabel {
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;;
    color: #2c3e50; /* Xanh Navy tiêu chuẩn */
    font-weight: 600; /* Hơi đậm nhẹ để dễ đọc */
}

/* =========================================
   2. Ô NHẬP LIỆU (LINE EDIT &amp; COMBOBOX)
========================================= */
QLineEdit, QComboBox {
    padding: 8px 12px; /* Tăng không gian thở bên trong ô */
    border: 1px solid #cbd5e1;
    border-radius: 6px; /* Bo góc mềm mại hơn (6px thay vì 4px) */
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;;
    background-color: #ffffff; /* Ép nền trắng tuyệt đối */
    color: #2c3e50; /* Chữ gõ vào màu Navy */
}

/* Fix dứt điểm lỗi ComboBox bị đen xì */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    selection-background-color: #34495e; /* Màu dòng được chọn khi xổ xuống */
    selection-color: #ffffff;
    border: 1px solid #cbd5e1;
    outline: none;
}

QComboBox::drop-down {
    border-left: 1px solid #cbd5e1;
    width: 30px;
}

/* Hiệu ứng focus (khi click chuột vào ô để gõ) */
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #2c3e50; /* Viền Navy nổi bật thay vì xanh dương sáng */
    background-color: #ffffff;
}

/* =========================================
   3. NÚT BẤM (BUTTONS)
========================================= */
/* Nút OK - Nhân vật chính */
QPushButton#btnOK { 
    background-color: #2c3e50; /* Trả về đúng tone Navy chuẩn */
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px; /* Nút to, dài hơn nhìn sẽ rất sang */
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
}

QPushButton#btnOK:hover {
    background-color: #34495e; /* Sáng lên một chút khi di chuột qua */
}

QPushButton#btnOK:pressed {
    background-color: #1a252f; /* Tối đi và cảm giác lún xuống khi click */
}

/* Nút Cancel - Nhân vật phụ */
QPushButton#btnCancel { 
    background-color: #cbd5e1; /* Màu xám trung tính, không tranh spotlight với nút OK */
    color: #334155;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
}

QPushButton#btnCancel:hover {
    background-color: #94a3b8; /* Xám đậm lên khi hover */
    color: white;
}</string>
