    <property name="styleSheet">
     <string notr="true">/* Tùy chỉnh vùng nền của Sidebar */
QFrame#frameThongTin {
    background-color: #2c3e50; /* Xanh navy đậm, tạo sự tương phản mạnh mẽ, chuyên nghiệp */
    border-right: 1px solid #1a252f;
    margin: 0px;
}

/* Tùy chỉnh Tiêu đề phần mềm */
QLabel#lblTieuDe {
    color: #ffffff; /* Chữ màu trắng */
    font-size: 18px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    padding-bottom: 20px;
    border-bottom: 2px solid #34495e; /* Đường kẻ mỏng phân cách tiêu đề và nội dung */
}

/* Tùy chỉnh các nút bấm trong Menu */
QPushButton#btnThongKeLuong,
QPushButton#btnThongTinNhom,
QPushButton#btnThemPhongBan,
QPushButton#btnXoaPhongBan {
    background-color: #34495e; /* Màu nền nhạt hơn viền một chút */
    color: #ecf0f1; /* Chữ trắng xám */
    border: none;
    border-radius: 8px; /* Bo góc mềm mại */
    padding: 12px 15px; /* Tăng khoảng cách để nút to, dễ bấm hơn */
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    text-align: center; /* Tạm căn giữa theo ảnh của bạn, nếu thích có thể đổi thành 'left' */
}

/* Hiệu ứng khi di chuột qua nút (Hover) */
QPushButton#btnThongKeLuong:hover,
QPushButton#btnThongTinNhom:hover {
    background-color: #3498db; /* Đổi sang màu xanh dương sáng */
    color: #ffffff;
    /* border-left: 4px solid #f1c40f; */ /* Tùy chọn: Thêm viền vàng bên trái khi hover để tạo điểm nhấn */
}

/* Hiệu ứng khi click nút (Pressed) */
QPushButton#btnThongKeLuong:pressed,
QPushButton#btnThongTinNhom:pressed {
    background-color: #2980b9;
}</string>
