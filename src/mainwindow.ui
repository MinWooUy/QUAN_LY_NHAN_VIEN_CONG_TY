  <property name="styleSheet">
   <string notr="true">/* 1. Tổng thể cửa sổ chính */
QMainWindow {
    background-color: #f4f7f6;
}

/* 2. Widget trung tâm (Vùng chứa toàn bộ nội dung) */
QWidget#centralwidget {
    background-color: #f4f7f6;
}

/* 3. Tiêu đề lớn (Ví dụ: Chữ &quot;Tìm kiếm&quot; - label_2) */
QLabel#label_2 {
    color: #2c3e50;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 10px;
}

/* 4. Ô nhập liệu tìm kiếm (khớp tên lineEdit) */
QLineEdit#lineEdit {
    border: 2px solid #bdc3c7;
    border-radius: 18px; /* Bo tròn sành điệu */
    padding: 8px 15px;
    background: white;
    color: #1e293b;
    font-family: &quot;Segoe UI&quot;;
}

QLineEdit#lineEdit:focus {
    border: 2px solid #2c3e50; /* Đổi màu viền khi click vào */
}

/* 5. Nút bấm (khớp tên pushButton - ví dụ nút Tìm kiếm/Reset) */
QPushButton#pushButton {
    background-color: #2c3e50;
    color: white;
    border-radius: 15px;
    padding: 8px 20px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    min-width: 80px;
}

QPushButton#pushButton:hover {
    background-color: #2980b9;
}

QPushButton#pushButton:pressed {
    background-color: #1c5980;
}

/* 6. Bảng dữ liệu (khớp tên tableWidget) */
QTableWidget#tableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    gridline-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    font-family: &quot;Segoe UI&quot;;
    color: #1e293b;
}

/* Header ngang (Tên cột) */
QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 12px 5px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-right: 1px solid #2980b9;
}

/* Header dọc (Số thứ tự STT) */
QHeaderView::section:vertical {
    background-color: #2c3e50;
    color: white;
    padding: 5px;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #2980b9;
}

/* Ô dữ liệu cụ thể */
QTableWidget#tableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget#tableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

/* 7. Menu bar (Thanh menu trên cùng) */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dcdde1;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
}

/* 8. Thanh cuộn dọc (Scrollbar) */
QScrollBar:vertical {
    border: none;
    background: #f1f1f1;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}</string>
