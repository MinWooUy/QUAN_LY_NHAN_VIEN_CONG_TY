    <widget class="QWidget" name="page_2">
     <property name="styleSheet">
      <string notr="true">/* Tùy chỉnh vùng cuộn danh sách phòng ban */
QScrollArea#scrollPhongBan {
    border: none;
    background-color: #f4f7f6; /* Đồng bộ màu nền với cửa sổ chính */
}

/* Quan trọng: Phải chỉnh nền cho widget con bên trong ScrollArea */
QWidget#scrollAreaWidgetContents {
    background-color: #f4f7f6;
}

/* Custom thanh cuộn cho Page 2 (mỏng và hiện đại hơn) */
QScrollArea#scrollPhongBan QScrollBar:vertical {
    border: none;
    background: #e2e8f0;
    width: 6px;
    border-radius: 3px;
}

QScrollArea#scrollPhongBan QScrollBar::handle:vertical {
    background: #94a3b8;
    border-radius: 3px;
}

/* Custom giao diện cho từng Card phòng ban (nếu bạn dùng QFrame làm container trong PhongBanCard) */
/* Giả sử bên trong PhongBanCard bạn có 1 QFrame tên là mainFrame */
QFrame#mainFrame {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

/* Hiệu ứng đổ bóng nhẹ khi di chuột vào Card (nếu Qt version hỗ trợ hoặc dùng hiệu ứng màu) */
QFrame#mainFrame:hover {
    border: 1px solid #3498db;
    background-color: #f0f9ff;
}</string>
