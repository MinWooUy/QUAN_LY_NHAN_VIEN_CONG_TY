      <property name="styleSheet">
       <string notr="true">QLabel#lblSiSo {
    background-color: #ffffff;      /* Nền trắng làm nổi bật con số */
    color: #2c3e50;                 /* Chữ màu xanh Navy đậm */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 15px;                /* Chữ to vừa phải */
    font-weight: bold;              /* In đậm để dễ đọc */
    padding: 8px 16px;              /* Khoảng thở xung quanh chữ */
    border: 1px solid #cbd5e1;      /* Viền xám nhạt */
    border-radius: 6px;             /* Bo góc mềm mại */
    border-left: 5px solid #2c3e50; /* Vạch nhấn màu xanh dương sáng ở viền trái */
}

/* Hiệu ứng nhẹ khi di chuột ngang qua (tùy chọn) */
QLabel#lblSiSo:hover {
    background-color: #f8fafc;
    border-left: 5px solid  #3498db; 
}</string>
      </property>
      <property name="text">
